// Spike da Fase 0: protótipo SSMS em Slint.
// Slint não tem docking: o layout é fixo (splitters e abas), o que já é um
// resultado do spike.
import { Button, ListView, TabWidget, TextEdit, ComboBox, Palette } from "std-widgets.slint";

export struct TreeRow {
    text: string,
    depth: int,
    expandable: bool,
    expanded: bool,
    loading: bool,
}

export struct GridRow {
    n: string, id: string, nome: string, email: string, criado: string, saldo: string,
}

export component AppWindow inherits Window {
    title: "Spike Slint — PGStudio";
    preferred-width: 1280px;
    preferred-height: 800px;

    in property <[TreeRow]> tree;
    in property <[GridRow]> grid;
    in-out property <string> sql;
    in-out property <string> status: "Pronto";
    in-out property <length> grid-scroll;
    in-out property <int> selected: -1;
    callback toggle(int);
    callback new-query();
    callback execute();

    MenuBar {
        Menu {
            title: "File";
            MenuItem { title: "New Query"; shortcut: @keys(Control + N); activated => { root.new-query(); } }
            MenuItem { title: "Save"; shortcut: @keys(Control + S); }
            MenuItem { title: "Save As…"; shortcut: @keys(Control + Shift + S); }
            MenuSeparator { }
            MenuItem { title: "Exit"; }
        }
        Menu { title: "Edit"; MenuItem { title: "(spike)"; } }
        Menu { title: "View"; MenuItem { title: "(spike)"; } }
        Menu {
            title: "Query";
            MenuItem { title: "Execute"; shortcut: @keys(F5); activated => { root.execute(); } }
            MenuItem { title: "Execute (Ctrl+E)"; shortcut: @keys(Control + E); activated => { root.execute(); } }
        }
        Menu { title: "Tools"; MenuItem { title: "(spike)"; } }
        Menu { title: "Window"; MenuItem { title: "(spike)"; } }
        Menu { title: "Help"; MenuItem { title: "(spike)"; } }
    }

    VerticalLayout {
        HorizontalLayout {
            padding: 4px;
            spacing: 4px;
            alignment: start;
            Button { text: "New Query"; clicked => { root.new-query(); } }
            Button { text: "Execute"; clicked => { root.execute(); } }
            Button { text: "Cancel"; }
            Button { text: "Estimated Plan"; }
            ComboBox { model: ["db_00", "db_01", "db_02"]; }
        }

        HorizontalLayout {
            spacing: 4px;
            padding-left: 4px;
            padding-right: 4px;

            // Object Explorer: árvore achatada num ListView virtualizado.
            TabWidget {
                width: 280px;
                Tab {
                    title: "Object Explorer";
                    ListView {
                        for row[i] in root.tree: Rectangle {
                            height: 22px;
                            background: i == root.selected ? Palette.selection-background : transparent;
                            HorizontalLayout {
                                padding-left: row.depth * 14px + 4px;
                                spacing: 4px;
                                Text {
                                    width: 14px;
                                    vertical-alignment: center;
                                    text: row.loading ? "…" : row.expandable ? (row.expanded ? "▼" : "▶") : "";
                                }
                                Text { vertical-alignment: center; text: row.text; }
                            }
                            TouchArea {
                                clicked => { root.selected = i; }
                                double-clicked => { if row.expandable { root.toggle(i); } }
                            }
                            TouchArea {
                                x: row.depth * 14px;
                                width: 22px;
                                clicked => { if row.expandable { root.toggle(i); } }
                            }
                        }
                    }
                }
            }

            VerticalLayout {
                spacing: 4px;
                TabWidget {
                    Tab {
                        title: "SQLQuery1.sql";
                        VerticalLayout {
                            TextEdit {
                                font-family: "DejaVu Sans Mono";
                                text <=> root.sql;
                            }
                        }
                    }
                }
                TabWidget {
                    Tab {
                        title: "Results";
                        VerticalLayout {
                            HorizontalLayout {
                                height: 22px;
                                for h in ["#", "id", "nome", "email", "criado_em", "saldo"]: Text {
                                    width: 130px; font-weight: 700; text: h; vertical-alignment: center;
                                }
                            }
                            ListView {
                                content-y <=> root.grid-scroll;
                                for r[i] in root.grid: Rectangle {
                                    height: 20px;
                                    background: Math.mod(i, 2) == 0 ? transparent : Palette.alternate-background;
                                    HorizontalLayout {
                                        Text { width: 130px; text: r.n; overflow: elide; color: Palette.foreground.transparentize(40%); }
                                        Text { width: 130px; text: r.id; overflow: elide; }
                                        Text { width: 130px; text: r.nome; overflow: elide; }
                                        Text { width: 130px; text: r.email; overflow: elide; }
                                        Text { width: 130px; text: r.criado; overflow: elide; }
                                        Text { width: 130px; text: r.saldo; overflow: elide; }
                                    }
                                }
                            }
                        }
                    }
                    Tab { title: "Messages"; Text { text: "Commands completed successfully."; } }
                }
            }

            TabWidget {
                width: 220px;
                Tab {
                    title: "Properties";
                    VerticalLayout {
                        alignment: start;
                        Text { text: "Nome: " + (root.selected >= 0 && root.selected < root.tree.length ? root.tree[root.selected].text : "(nada)"); }
                        Text { text: "Owner: postgres"; }
                    }
                }
            }
        }

        HorizontalLayout {
            padding: 4px;
            spacing: 16px;
            height: 24px;
            alignment: start;
            Text { text: root.status; }
            Text { text: "localhost (17)"; }
            Text { text: "postgres"; }
        }
    }
}
